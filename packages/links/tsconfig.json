{
  "extends": "@repo/typescript-config/server.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
