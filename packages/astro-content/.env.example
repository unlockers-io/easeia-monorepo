# Build-time inputs for the `easeia-prefetch-images` CLI and the `easeiaLoader`
# content loader this package publishes. Both run inside a consumer Astro
# site's build rather than in this monorepo, so the values are set in that
# site's environment; they are declared here because the code that reads them
# lives in this package.

# Required: base URL of the Easeia build API that the loader and the
# prefetcher call. There is no default, so a missing value fails the consumer
# site's build. Against the local stack this is `https://easeia.api.localhost`.
EASEIA_API_URL=https://api.easeia.com

# Required: the cuid of the site whose posts and images are being pulled.
# Issued per site, so there is no value to fill in here.
EASEIA_SITE_ID=

# Required: a `content:read` API key scoped to EASEIA_SITE_ID. Issued per
# site, so there is no value to fill in here.
EASEIA_API_KEY=

# Optional: directory the prefetcher downloads hero and inline images into,
# relative to the Astro site root. Falls back to `src/content/posts/images`
# when unset, which is where the content collection's `image()` schema expects
# to find them, so most sites need nothing here.
EASEIA_IMAGES_DIR=
