# Required infrastructure and secrets. Local dev infrastructure: docker compose up -d
DATABASE_URL=postgresql://easeia:easeia123@localhost:5440/easeia
PGAPPNAME=easeia:local:tools
REDIS_URL=redis://localhost:6381
# Generate a unique secret: openssl rand -hex 32
BETTER_AUTH_SECRET=
# AES-256-GCM key, exactly 32 bytes in base64: openssl rand -base64 32
WP_ENCRYPTION_KEY=

# Public URLs for plain local development. Required when serving custom production hosts.
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional integrations. Blank means disabled; manual drafts and publishing still work.
# OpenAI: AI drafts, rewrites, embeddings, and image generation are unavailable when unset.
OPENAI_API_KEY=
# Shared across every site and app using this database, per UTC calendar month.
# Zero disables new AI calls. This is an estimated allowance, not provider billing.
AI_MONTHLY_BUDGET_USD=18
# Optional: defer enforcement until this UTC month. Blank enforces immediately.
AI_BUDGET_START_MONTH=2026-10
OPENAI_IMAGE_QUALITY=medium
# DataForSEO: no live keyword ranks, backlink metrics, or metered SEO audits when unset.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Google Search Console: no OAuth connection, impressions, clicks, or indexing data when unset.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Email: no email verification or password-recovery mail when unset. Set both to enable.
RESEND_API_KEY=
FROM_EMAIL=
# R2: image uploads and generated hero/inline image delivery need all five values.
# Endpoint format: https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Advanced
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Every registered user has full admin access. first-user closes after the first account.
SIGNUP_MODE=first-user
# Comma-separated host patterns for custom production/preview auth hosts (e.g. app.example.com).
AUTH_ALLOWED_HOSTS=
# Additional exact trusted origins, e.g. https://app.example.com
TRUSTED_ORIGINS=
# Landing-only links and waitlist API; the admin web app does not call the public API.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
WORKER_CONCURRENCY=4
HERO_AUTOGEN_ENABLED=true
BODY_IMAGES_ENABLED=false
# Only these models are priced by the budget guard; other overrides fail before calling OpenAI.
OPENAI_GENERATION_MODEL=gpt-5.6-luna
OPENAI_REWRITE_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
# Embeddings stay text-embedding-3-small (1536 dimensions). There is no embedding override.
# Optional seed. Production requires all three values when explicitly running pnpm seed.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Instance Admin
# Demo seed (pnpm seed:demo). Refuses to run unless DEMO_SEED=true and the
# database name ends in _demo. The password needs at least 12 characters.
# DEMO_SEED=true
# DEMO_ADMIN_PASSWORD=
# Enable only in isolated e2e environments. Never enable on a public instance.
EXPOSE_TESTING_API=0

# Optional maintenance tool inputs
# MONEY_SITE_DOMAIN=acmestudios.example
# MONEY_SITE_NAME=Acme Studios
# MONEY_SITE_SITEMAP_URL=https://acmestudios.example/sitemap.xml
# MONEY_SITE_PATH_PREFIX=/spaces/
# REPOS_DIR=/path/to/site-repositories

# Landing only: browser-facing waitlist API and opt-in hosted analytics.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Exact socket IPs of trusted reverse proxies. Empty ignores forwarded IP headers.
TRUSTED_PROXY_IPS=
