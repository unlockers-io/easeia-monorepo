{
  "name": "easeia-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "turbo run start",
    "dev": "pnpm exec turbo dev",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:seed": "tsx tools/seed/index.ts",
    "seed:money-site": "tsx tools/seed-money-site/src/index.ts",
    "aggregate:site-niches": "tsx tools/aggregate-site-niches/src/index.ts",
    "backfill:body-images": "tsx tools/backfill-body-images/index.ts",
    "enrich:links": "tsx tools/enrich-internal-links/index.ts",
    "fix:onpage-seo": "tsx tools/fix-onpage-seo/index.ts",
    "regen:heroes": "tsx tools/maintenance/regenerate-heroes.ts",
    "merge:tag-variants": "tsx tools/merge-tag-variants/index.ts",
    "rewrite:eval": "tsx tools/rewrite-eval/index.ts",
    "rewrite:candidates": "tsx tools/maintenance/rewrite-candidates.ts",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@easeia/astro-content && changeset publish",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit",
    "prepare": "husky",
    "dev:plain": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev:plain --env-mode=loose",
    "seed:demo": "tsx tools/seed/demo.ts",
    "check:shadcn": "node scripts/check-shadcn.mjs",
    "normalize:posts": "tsx tools/normalize-posts/index.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@next/playwright": "^16.3.0",
    "@playwright/test": "^1.63.0",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/portless-env": "workspace:*",
    "@repo/sites": "workspace:*",
    "@repo/transactional": "workspace:*",
    "@shadcn/lint": "0.2.0",
    "better-auth": "^1.7.20",
    "fallow": "^3.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-config-awesomeness": "^4.9.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.3"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
