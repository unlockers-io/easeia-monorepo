# syntax=docker/dockerfile:1
FROM node:24-slim AS runtime
RUN apt-get update && apt-get install --yes --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

FROM runtime AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app
RUN npm install --global pnpm@11.13.1 turbo@2.10.12

FROM base AS pruner
COPY . .
RUN turbo prune api worker web @tools/seed --docker

FROM base AS dependencies
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm install --frozen-lockfile --ignore-scripts

FROM dependencies AS build
COPY --from=pruner /app/out/full/ .
COPY LICENSE ./LICENSE
RUN pnpm rebuild
# Builds require no database, Redis, API keys, or application secrets.
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm exec turbo run build --filter=api --filter=worker --filter=web
RUN mkdir -p apps/web/public

FROM base AS production-dependencies
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm install --prod --frozen-lockfile --ignore-scripts

FROM runtime AS service
WORKDIR /app
ENV NODE_ENV=production
COPY --from=production-dependencies --chown=node:node /app/ ./
USER node

FROM service AS api
COPY --from=build --chown=node:node /app/apps/api/dist/ ./apps/api/dist/
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:4000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/index.mjs"]

FROM service AS worker
COPY --from=build --chown=node:node /app/apps/worker/dist/ ./apps/worker/dist/
CMD ["node", "apps/worker/dist/index.mjs"]

FROM runtime AS web
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=node:node /app/apps/web/.next/standalone/ ./
COPY --from=build --chown=node:node /app/apps/web/.next/static/ ./apps/web/.next/static/
COPY --from=build --chown=node:node /app/apps/web/public/ ./apps/web/public/
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

FROM build AS schema
ENV NODE_ENV=production
COPY scripts/docker-schema.sh ./scripts/docker-schema.sh
USER node
CMD ["sh", "scripts/docker-schema.sh"]
