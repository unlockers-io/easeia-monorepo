{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "portless run --name easeia.api tsdown --watch --on-success \"node dist/index.mjs\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:plain": "tsdown --watch --on-success \"node dist/index.mjs\""
  },
  "dependencies": {
    "@easeia/astro-content": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@repo/api-types": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/backfill": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/identity": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/links": "workspace:*",
    "@repo/money-sites": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/policy": "workspace:*",
    "@repo/portless-env": "workspace:*",
    "@repo/posts": "workspace:*",
    "@repo/sites": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.5",
    "@scalar/openapi-to-markdown": "^0.6.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.9",
    "hono-rate-limiter": "^0.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/ai": "workspace:*",
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod-compiler": "^1.27.0"
  }
}
