# App subset; see the root .env.example for the full configuration.
# Database
DATABASE_URL=postgresql://easeia:easeia123@localhost:5440/easeia
PGAPPNAME=easeia:local:api

# Redis (BullMQ)
REDIS_URL=redis://localhost:6381

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Better Auth. The base URL is derived from the request via Better Auth's
# dynamic baseURL (allowedHosts); set AUTH_ALLOWED_HOSTS for prod/preview
# domains beyond *.localhost.
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Comma-separated list of host patterns that should be treated as trusted
# origins by Better Auth's dynamic baseURL. Local *.localhost is built-in.
# Example: app.easeia.com,api.easeia.com,*.easeia-preview.vercel.app
# AUTH_ALLOWED_HOSTS=

# CORS (Hono). Defaults to https://easeia.web.localhost when unset.
# CORS_ORIGINS=https://easeia.web.localhost,https://easeia.landing.localhost

# Trusted Origins for Better Auth — exact origins for plain
# http://localhost:PORT-style requests that bypass the host-pattern auto-trust.
# AUTH_ALLOWED_HOSTS already covers host-pattern matches.
# TRUSTED_ORIGINS=https://easeia.web.localhost,https://easeia.landing.localhost

# At-rest encryption for Site app passwords + Google OAuth tokens.
# Must decode to 32 bytes. Generate: openssl rand -base64 32
WP_ENCRYPTION_KEY=

# DataForSEO (login + password; password is a generated API key, NOT account password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional: Resend API for transactional email. When unset, signup falls
# back to no-verification mode (requireEmailVerification gated on this).
RESEND_API_KEY=
FROM_EMAIL="Easeia <noreply@email.easeia.com>"

# Plain local development (pnpm dev:plain):
# WEB_APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Exact socket IPs of trusted reverse proxies. Empty ignores forwarded IP headers.
TRUSTED_PROXY_IPS=
