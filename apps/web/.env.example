# App subset; see the root .env.example for the full configuration.
# API URL (for Better Auth client and any browser-side fetches)

# Database (for server-side session validation + RSC data fetching)
DATABASE_URL=postgresql://easeia:easeia123@localhost:5440/easeia
PGAPPNAME=easeia:local:web

# Redis (BullMQ — server actions enqueue jobs to the worker)
REDIS_URL=redis://localhost:6381

# Better Auth (for server-side session validation). The base URL is derived
# from the request via Better Auth's dynamic baseURL (allowedHosts); set
# AUTH_ALLOWED_HOSTS for prod/preview domains beyond *.localhost.
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Sender address for all transactional/auth mail. Required: there is no default,
# so a missing value fails startup instead of mailing from the wrong domain.
FROM_EMAIL="Easeia <noreply@email.easeia.com>"

# Optional: Resend API for email. Mail is skipped entirely when this is unset.
RESEND_API_KEY=
# Sends mail to the e2e Resend stub (tests/e2e/support/resend-stub.ts) instead of api.resend.com.
# RESEND_BASE_URL=http://127.0.0.1:3999
# Port the e2e Resend stub listens on; must match RESEND_BASE_URL.
# RESEND_STUB_PORT=3999

# Comma-separated host patterns trusted by Better Auth's dynamic baseURL.
# Local *.localhost is built-in.
# AUTH_ALLOWED_HOSTS=

# Web origin — used as the metadataBase for Open Graph / Twitter card
# image URL resolution. Optional in dev (falls back to easeia.web.localhost).
WEB_APP_URL=https://easeia.web.localhost

# DataForSEO (server-only)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google OAuth — Search Console integration. Create OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# https://<your-app-host>/api/google/callback (one per environment).
# Enable the "Google Search Console API" for the project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encryption for at-rest secrets (Site app passwords + Google OAuth tokens).
# Must decode to 32 bytes. Generate: openssl rand -base64 32
WP_ENCRYPTION_KEY=

# OpenAI key powering the "Improve SEO with AI" action on the post detail
# page. Optional in dev — when unset the suggest action returns a clear
# error rather than crashing.
OPENAI_API_KEY=

# Plain local development (pnpm dev:plain):
# WEB_APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
