# App subset; see the root .env.example for the full configuration.
NODE_ENV=development

# PostgreSQL (Neon recommended; pgvector extension required)
DATABASE_URL=postgresql://easeia:easeia123@localhost:5440/easeia
PGAPPNAME=easeia:local:worker

# BullMQ (Upstash Redis recommended)
REDIS_URL=rediss://default:pass@host:6379

# 32-byte base64 key — must match apps/api so encrypted WP creds round-trip.
# Generate: openssl rand -base64 32
WP_ENCRYPTION_KEY=

# Concurrency cap; raise as Astro hosting throughput allows.
WORKER_CONCURRENCY=4

# Optional. Origin of the Next.js app — needed for the GSC OAuth redirect
# URI when SNAPSHOT_SITE / BACKFILL_GSC_LINKS refresh Google tokens. When
# unset, those handlers skip GSC instead of failing.
APP_URL=

# DataForSEO API (https://dataforseo.com)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OpenAI — used by the EMBED handler for text-embedding-3-small (1536 dims).
# Optional: when unset, the EMBED job is a no-op and similar-posts surfaces
# stay empty.
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=18
AI_BUDGET_START_MONTH=2026-10
OPENAI_IMAGE_QUALITY=medium

# Master switch for automatic hero-image generation (inline at publish + hourly backfill). "true" (default) or "false".
HERO_AUTOGEN_ENABLED=true
# Body images are opt-in; the default generates only a hero per post.
BODY_IMAGES_ENABLED=false

# Cloudflare R2 (S3-compatible) — object store for post hero/inline images.
# The worker uploads here during PUBLISH and hero generation via @repo/blob.
# - R2_ENDPOINT: the S3 API endpoint without the bucket path
#   (e.g. https://<account>.r2.cloudflarestorage.com)
# - R2_BUCKET: bucket name
# - R2_PUBLIC_BASE_URL: the public read URL base. Either the bucket's r2.dev
#   subdomain (https://pub-<hash>.r2.dev) or a custom domain bound to the
#   bucket via Cloudflare. URLs stored in PostImage.blobUrl are
#   `${R2_PUBLIC_BASE_URL}/${key}`.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Plain local development (pnpm dev:plain):
# WEB_APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
