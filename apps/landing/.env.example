# App subset; see the root .env.example for the full configuration.
# Optional: origin of the web app (apps/web) that the marketing pages link to
# for login, register and the pricing CTAs. Falls back to
# `https://app.easeia.com` when unset, so production is already correct and
# only local dev needs this repointed at the local web stack.
NEXT_PUBLIC_WEB_APP_URL=https://easeia.web.localhost

# Plain local development (pnpm dev:plain):
# WEB_APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Landing only: browser-facing waitlist API and opt-in hosted analytics.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_ANALYTICS=false
