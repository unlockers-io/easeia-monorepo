{
  "name": "landing",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "portless run --name easeia.landing next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:plain": "next dev --turbopack --port 3001"
  },
  "dependencies": {
    "@repo/observability": "workspace:*",
    "@repo/social-image": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-form": "^1.33.4",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/portless-env": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
