{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "packages": ["apps/*", "packages/*", "tools/*"]
  },
  "entry": [
    "**/prisma.config.ts",
    "apps/*/src/lib/observability.ts",
    "apps/api/src/test-env.ts",
    "oxlint.config.ts",
    "packages/transactional/src/emails/**/*.tsx"
  ],
  "ignorePatterns": ["tests/e2e/setup/auth.setup.ts", ".github/ci/*.mjs"],
  "ignoreDependencies": [
    "better-auth",
    "hono",
    "@tailwindcss/postcss",
    "postcss",
    "postcss-load-config",
    "tailwindcss",
    "@prisma/client",
    "@vitest/coverage-v8",
    "jsdom",
    "shadcn",
    "@shadcn/lint",
    "react",
    "@react-email/ui",
    "react-email",
    "@types/react-dom",
    "react-dom",
    "@tanstack/react-form"
  ],
  "duplicates": {
    "ignore": ["apps/landing/src/app/privacy/page.tsx", "apps/landing/src/app/terms/page.tsx"]
  },
  "rules": {
    "unused-dependencies": "warn",
    "private-type-leaks": "off"
  },
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "boundaries": {
    "zones": [
      {
        "name": "app",
        "autoDiscover": ["apps"]
      },
      {
        "name": "package",
        "patterns": ["packages/**"]
      }
    ],
    "rules": [
      {
        "from": "package",
        "allow": ["package"]
      },
      {
        "from": "app",
        "allow": ["package"]
      }
    ]
  }
}
