# Postgres connection labels use this environment name (e.g. staging).
DEPLOY_ENVIRONMENT=production

# Run compose with: --env-file .env.selfhost -f compose.selfhost.yml
# Generate each of the first two values separately: openssl rand -hex 32
# Use a hexadecimal Postgres password; it is inserted into a database URL.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Generate: openssl rand -base64 32
WP_ENCRYPTION_KEY=
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
SIGNUP_MODE=first-user
# For custom production hosts, e.g. app.example.com,api.example.com
AUTH_ALLOWED_HOSTS=
TRUSTED_ORIGINS=

# Optional: seed an administrator instead of using first-run registration.
# All three values are required when SEED_ADMIN_EMAIL is set.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Instance Admin

# Optional integrations. See .env.example for the feature each enables.
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=18
AI_BUDGET_START_MONTH=2026-10
OPENAI_IMAGE_QUALITY=medium
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
RESEND_API_KEY=
FROM_EMAIL=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
WORKER_CONCURRENCY=4
HERO_AUTOGEN_ENABLED=true
BODY_IMAGES_ENABLED=false
# OPENAI_GENERATION_MODEL=gpt-5.6-luna
# OPENAI_REWRITE_MODEL=gpt-5.6-luna
# OPENAI_IMAGE_MODEL=gpt-image-2
# WEB_PORT=3000
# API_PORT=4000

# Exact socket IPs of trusted reverse proxies. Empty ignores forwarded IP headers.
TRUSTED_PROXY_IPS=
